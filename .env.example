# Copy to .env (gitignored). Atlas Sandbox connection string (Atlas UI → Connect → Drivers).
# Also used by the MongoDB MCP server (scripts/mongodb-mcp.sh) — no shell profile setup needed.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="ground_control"

# Voyage AI embeddings (200M free tokens for the event)
VOYAGE_API_KEY=""

# LLM for the controller agent
ANTHROPIC_API_KEY=""
