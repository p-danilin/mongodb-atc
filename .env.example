# Copy to .env (gitignored). Optional: with no .env, Brain uses the local MongoDB from docker-compose.yml.
# Also used by the MongoDB MCP server (scripts/mongodb-mcp.sh) — no shell profile setup needed.
#
# Local (default): `docker compose up -d --wait`, then `cd backend && npm run seed`.
MONGODB_URI="mongodb://localhost:27017/?replicaSet=rs0&directConnection=true"
# Shared Atlas Sandbox instead (Atlas UI → Connect → Drivers). Everyone on the same cluster and
# MONGODB_DB shares one scenario, so give each person their own MONGODB_DB.
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="ground_control"

# Voyage AI embeddings (200M free tokens for the event)
VOYAGE_API_KEY=""

# LLM for the controller agent
ANTHROPIC_API_KEY=""
