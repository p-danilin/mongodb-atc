# Base URL of Brain (backend). The websocket URL is derived from it. Defaults to http://localhost:4100.
VITE_API_URL=http://localhost:4100

# The ElevenLabs agent that plays Ground on the radio. `npm run voice:setup` in backend/ creates it and
# writes this into frontend/.env.local. Without it the Ground frequency card shows setup instructions.
VITE_ELEVENLABS_AGENT_ID=
